# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key. Keep this secret — never paste into client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Meta App Secret (Meta for Developers → App Settings → Basic).
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# UI language: en | ko | pt | es
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL
# ============================================================

# ALLOWED_INVITE_HOSTS=crm.example.com
# AUTOMATION_CRON_SECRET=
# META_APP_ID=
# WHATSAPP_TEMPLATES_DRY_RUN=false
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
# ALLOWED_DEV_ORIGINS=
